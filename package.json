{
  "name": "tournamentlib",
  "version": "0.1.0",
  "description": "TS library to manage your tournaments ",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-sort-class-members": "^1.22.1",
    "husky": "^9.1.7",
    "jest": "^30.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "trailingComma": "none",
    "printWidth": 120,
    "objectWrap": "preserve"
  },
  "lint-staged": {
    "*.{js,ts,css,md,json}": "prettier --write",
    "*.ts": "eslint --fix"
  }
}
